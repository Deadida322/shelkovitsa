{
	"name": "shelkovitsa-server",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"engines": {
		"node": ">=24.11.0 <25"
	},
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"lint:check": "eslint \"{src,test}/**/*.ts\"",
		"migrate:add": "nest build && typeorm migration:generate -d dist/db/datasource.js",
		"migrate:apply": "nest build && typeorm migration:run -d dist/db/datasource.js",
		"test": "vitest run",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"admin:create": "node dist/cli/create-admin.js",
		"db:reset": "node dist/cli/db-reset.js",
		"seed": "node dist/cli/seed.js",
		"dev:setup": "npm run build && npm run db:reset && npm run seed",
		"test:postman": "npx -y newman@6 run ../tests/Shelkovitsa_API.postman_collection.json --working-dir ../tests",
		"storage:init": "node dist/cli/storage-init.js",
		"audit:marketplace": "node dist/cli/marketplace-readiness.js"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@nestjs/common": "^12.2.0",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.2.0",
		"@nestjs/jwt": "^12.0.3",
		"@nestjs/platform-express": "^12.2.0",
		"@nestjs/schedule": "^12.0.2",
		"@nestjs/serve-static": "^12.0.0",
		"@nestjs/swagger": "^12.0.3",
		"@nestjs/throttler": "^6.7.1",
		"@nestjs/typeorm": "^12.0.2",
		"@types/papaparse": "^5.3.14",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.7",
		"helmet": "^8.1.0",
		"moment": "^2.30.1",
		"node-xlsx": "^0.24.0",
		"path": "^0.12.7",
		"pg": "^8.12.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"swagger-ui-express": "^5.0.1",
		"telegraf": "^4.16.3",
		"typeorm": "^0.3.20"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.0.9",
		"@swc/core": "^1.16.20",
		"@types/bcrypt": "^5.0.2",
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.3.0",
		"@types/node": "^24.19.2",
		"@types/supertest": "^6.0.0",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.72.0",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"prettier": "^3.0.0",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.3",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.1.3",
		"unplugin-swc": "^2.0.0",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"qs": "^6.15.4"
	},
	"allowScripts": {
		"bcrypt@6.0.0": true,
		"@nestjs/core": false,
		"@scarf/scarf": false,
		"@swc/core@1.16.20": true
	}
}
