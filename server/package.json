{
	"name": "shelkovitsa-server",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"engines": {
		"node": ">=20.19.0 <21"
	},
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"lint:check": "eslint \"{src,test}/**/*.ts\"",
		"migrate:add": "nest build && typeorm migration:generate -d dist/db/datasource.js",
		"migrate:apply": "nest build && typeorm migration:run -d dist/db/datasource.js",
		"test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
		"admin:create": "node dist/cli/create-admin.js",
		"db:reset": "node dist/cli/db-reset.js",
		"seed": "node dist/cli/seed.js",
		"dev:setup": "npm run build && npm run db:reset && npm run seed"
	},
	"dependencies": {
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.2.3",
		"@nestjs/core": "^10.0.0",
		"@nestjs/jwt": "^10.2.0",
		"@nestjs/passport": "^10.0.3",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/schedule": "^4.0.0",
		"@nestjs/serve-static": "^4.0.2",
		"@nestjs/swagger": "^7.4.0",
		"@nestjs/throttler": "^6.7.1",
		"@nestjs/typeorm": "^10.0.2",
		"@types/papaparse": "^5.3.14",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.7",
		"helmet": "^8.1.0",
		"moment": "^2.30.1",
		"nestjs-form-data": "^1.9.92",
		"nestjs-telegraf": "^2.8.1",
		"node-xlsx": "^0.24.0",
		"path": "^0.12.7",
		"pg": "^8.12.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"swagger-ui-express": "^5.0.1",
		"telegraf": "^4.16.3",
		"typeorm": "^0.3.20"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.4.9",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@types/bcrypt": "^5.0.2",
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.2",
		"@types/multer": "^1.4.12",
		"@types/node": "^20.3.1",
		"@types/supertest": "^6.0.0",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.72.0",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"jest": "^29.5.0",
		"prettier": "^3.0.0",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.3",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.1.3"
	},
