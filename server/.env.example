DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_HOST=localhost
DB_NAME=shelkovitsa
PORT=8000
# development | production | test
NODE_ENV=production
# error | warn | log (info) | debug | verbose
LOG_LEVEL=info
IS_LOGGING_ROUTE=true

# Секреты: сгенерируйте свои, например `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN="1 day"

# Абсолютные пути — хранилище вне каталога проекта на сервере (создаёт deploy.sh)
TEMP_PATH="/temp/src"
DEST_PATH="/temp/dist"
UPLOAD_MAX_FILE_SIZE_MB=20

# Хранилище фото: local — DEST_PATH на диске; s3 — S3-совместимый бакет
# (Selectel, Yandex Object Storage, RustFS/MinIO). Бакет: npm run storage:init [-- --public]
STORAGE_DRIVER=local
# S3_ENDPOINT=https://s3.storage.selcloud.ru
# S3_REGION=ru-1
# S3_BUCKET=shelkovitsa
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
# публичный адрес бакета/CDN: /static/<имя> редиректит туда; пусто — бэкенд отдаёт файлы сам
# S3_PUBLIC_URL=https://shelkovitsa.s3.storage.selcloud.ru

# Разрешённые origin через запятую
CORS=http://localhost:3000

# Ограничение частоты запросов (false — выключить, например для нагрузочных тестов)
THROTTLE_ENABLED=true

TELEGRAM_ENABLED=true
TELEGRAM_TOKEN="<токен бота от @BotFather>"
ADMIN_TG_ID=<id администратора в Telegram>
CHAT_TG_ID=<id чата для уведомлений о заказах>
