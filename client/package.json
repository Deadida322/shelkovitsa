{
    "name": "shelkovitsa-front",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=24.11.0 <25"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev --dotenv .env.dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "format": "prettier --write \"**/*.{js,mjs,cjs,ts,vue,json}\" --ignore-path .prettierignore",
        "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,vue,json}\" --ignore-path .prettierignore",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "lint:ci": "npm run format:check && npm run lint:check",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@nuxt/image": "^1.11.0",
        "@nuxtjs/google-fonts": "^3.2.0",
        "@pinia/nuxt": "^0.5.5",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "@vuesax-alpha/icons-vue": "^0.0.2-beta.12",
        "@vuesax-alpha/nuxt": "^0.0.5",
        "@vueuse/shared": "^9.13.0",
        "lodash": "^4.17.21",
        "maska": "^3.2.0",
        "nuxt": "^3.10.3",
        "pinia": "^2.2.5",
        "vue": "latest",
        "vue3-carousel": "^0.3.3",
        "vuesax": "^4.0.1-alpha.25",
        "vuesax-alpha": "^0.2.0-beta.80",
        "vuesax3": "^4.2.1",
        "vuetify": "^3.7.6",
        "vuetify-nuxt-module": "^0.16.1"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^3.8.0",
        "@nuxt/eslint": "^0.6.2",
        "eslint": "^9.27.0",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.10.1",
        "sass": "^1.77.8",
        "typescript": "^5.6.3",
        "vitest": "^3.2.7"
    },
    "allowScripts": {
        "esbuild@0.20.2": true,
        "esbuild@0.21.5": true,
        "esbuild@0.24.2": true,
        "sharp@0.32.6": true,
        "unrs-resolver@1.11.1": true,
        "vue-demi@0.13.11": true,
        "vue-demi@0.14.10": true,
        "vuesax": false
    }
}
