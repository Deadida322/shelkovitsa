# Скрипты деплоя только с переводом строк LF (иначе на Linux: bash\r: No such file)
deploy/*.sh text eol=lf

# Исходники — LF, как в Prettier (endOfLine: lf) и EditorConfig
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.vue text eol=lf
